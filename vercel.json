{
  "functions": {
    "api/listening-tts.js": {
      "maxDuration": 60
    },
    "api/aemet.js": {
      "maxDuration": 300
    },
    "api/ia-recurso.js": {
      "maxDuration": 300
    },
    "api/saih.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/instagram",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/aemet",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/aemet",
      "schedule": "30 17 * * *"
    },
    {
      "path": "/api/saih",
      "schedule": "50 22 * * *"
    }
  ]
}
